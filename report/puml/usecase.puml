@startuml
!include style.iuml
left to right direction
skinparam linetype spline
skinparam nodesep 16
skinparam ranksep 55

actor Admin
actor Teacher
actor Student

rectangle "Student performance system" {
  usecase "Manage teachers" as UC1
  usecase "View evaluation" as UC2
  usecase "Manage question bank" as UC3
  usecase "Enter internal marks" as UC4
  usecase "Take exam" as UC5
  usecase "Predict category" as UC6
}

Admin --> UC1
Admin --> UC2
Teacher --> UC3
Teacher --> UC4
Student --> UC5
Student --> UC6
@enduml
